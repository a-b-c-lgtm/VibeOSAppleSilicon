// userspace/libc/cxx/new — chapter 132f
//
// Freestanding <new>.  Provides just enough for libcpp:
//   - placement new (`new (ptr) T(...)`) and array placement
//   - operator new / delete (single + array, throwing + nothrow)
//   - std::nothrow_t / std::nothrow
//   - std::bad_alloc (we abort instead of throwing; -fno-exceptions)
//
// The full libstdc++ <new> defines std::launder, std::align,
// std::hardware_destructive_interference_size, etc.  libcpp uses
// none of those.  Add them as needed when a TU surfaces the gap.
#ifndef _OSDEV_CXX_NEW
#define _OSDEV_CXX_NEW 1

#include <stddef.h>   // size_t

namespace std {
    struct nothrow_t { explicit nothrow_t() = default; };
    inline constexpr nothrow_t nothrow{};

    class bad_alloc {
    public:
        bad_alloc() noexcept = default;
        virtual ~bad_alloc() = default;
        virtual const char *what() const noexcept { return "bad_alloc"; }
    };
}

// Placement new / delete — language-level; the standard requires
// these be declared but they're implemented by the compiler.
inline void *operator new   (size_t, void *p) noexcept { return p; }
inline void *operator new[] (size_t, void *p) noexcept { return p; }
inline void  operator delete   (void *, void *) noexcept {}
inline void  operator delete[] (void *, void *) noexcept {}

// Heap-allocating forms — defined out-of-line in libc/cxxabi.c
// and pulled in via libosdevc.a (auto-linked by the wrapper).
// We deliberately do NOT define these inline here, because an
// inline definition forces every TU to instantiate `_Znwm` in
// its own comdat group; if malloc.h's static-inline malloc gets
// inlined into one of those groups, the linker may discard the
// only emitted copy of malloc when it picks a different comdat
// winner, breaking unrelated callers of malloc.  See chapter
// 132f notes.
void *operator new   (size_t n);
void *operator new[] (size_t n);
void *operator new   (size_t n, const std::nothrow_t &) noexcept;
void *operator new[] (size_t n, const std::nothrow_t &) noexcept;
void  operator delete   (void *p) noexcept;
void  operator delete[] (void *p) noexcept;
void  operator delete   (void *p, size_t) noexcept;
void  operator delete[] (void *p, size_t) noexcept;
void  operator delete   (void *p, const std::nothrow_t &) noexcept;
void  operator delete[] (void *p, const std::nothrow_t &) noexcept;

#endif
