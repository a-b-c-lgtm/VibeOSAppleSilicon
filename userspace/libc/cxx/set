// userspace/libc/cxx/set — chapter 132f
//
// Freestanding std::set.  Same approach as <map>: sorted vector,
// binary-search lookup, linear insert.  Good enough for gcc's
// host-side bookkeeping.
#ifndef _OSDEV_CXX_SET
#define _OSDEV_CXX_SET 1

#include "vector"
#include "utility"
#include "functional"

namespace std {

template <class _K, class _Cmp = less<_K>>
class set {
public:
    typedef _K            key_type;
    typedef _K            value_type;
    typedef unsigned long size_type;

private:
    vector<_K> _v;
    _Cmp       _cmp;

    size_type _lb(const _K &k) const {
        size_type lo = 0, hi = _v.size();
        while (lo < hi) {
            size_type mid = (lo + hi) / 2;
            if (_cmp(_v[mid], k)) lo = mid + 1;
            else                  hi = mid;
        }
        return lo;
    }

public:
    typedef const _K *iterator;
    typedef const _K *const_iterator;

    set() : _v(), _cmp() {}
    set(const set &o) : _v(o._v), _cmp(o._cmp) {}
    set(set &&o) noexcept : _v(std::move(o._v)), _cmp(std::move(o._cmp)) {}
    set &operator=(const set &o) { _v = o._v; _cmp = o._cmp; return *this; }
    set &operator=(set &&o) noexcept { _v = std::move(o._v); _cmp = std::move(o._cmp); return *this; }

    iterator       begin()       noexcept { return _v.data(); }
    iterator       end()         noexcept { return _v.data() + _v.size(); }
    const_iterator begin() const noexcept { return _v.data(); }
    const_iterator end()   const noexcept { return _v.data() + _v.size(); }

    bool      empty() const noexcept { return _v.empty(); }
    size_type size()  const noexcept { return _v.size(); }
    void      clear()       noexcept { _v.clear(); }

    iterator find(const _K &k) const {
        size_type i = _lb(k);
        if (i < _v.size() && !_cmp(k, _v[i])) return _v.data() + i;
        return end();
    }
    size_type count(const _K &k) const { return find(k) == end() ? 0 : 1; }

    pair<iterator, bool> insert(const _K &k) {
        size_type i = _lb(k);
        if (i < _v.size() && !_cmp(k, _v[i])) {
            return pair<iterator, bool>(_v.data() + i, false);
        }
        _v.insert(_v.begin() + i, k);
        return pair<iterator, bool>(_v.data() + i, true);
    }
    template <class... _Args>
    pair<iterator, bool> emplace(_Args&&... a) {
        return insert(_K(std::forward<_Args>(a)...));
    }

    size_type erase(const _K &k) {
        size_type i = _lb(k);
        if (i < _v.size() && !_cmp(k, _v[i])) {
            _v.erase(_v.begin() + i);
            return 1;
        }
        return 0;
    }
};

}  // namespace std

#endif
