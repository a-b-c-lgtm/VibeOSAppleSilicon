// userspace/libc/cxx/map — chapter 132f
//
// Freestanding std::map.  **NOT** a red-black tree — uses a
// sorted vector internally.  O(log n) lookup via binary search,
// O(n) insertion.  Correct semantics, terrible asymptotic perf,
// but gcc proper's build-host data structures here hold a few
// thousand entries at most, so it's fine.
//
// Provides what gcc's auto-profile.cc / gcov.cc actually call:
// insert, find, erase, operator[], at, begin/end, size, empty,
// clear, count.
#ifndef _OSDEV_CXX_MAP
#define _OSDEV_CXX_MAP 1

#include "vector"
#include "utility"
#include "functional"

namespace std {

template <class _K, class _V, class _Cmp = less<_K>>
class map {
public:
    typedef _K                       key_type;
    typedef _V                       mapped_type;
    typedef pair<const _K, _V>       value_type;
    typedef unsigned long            size_type;

private:
    // Store pair<_K, _V> (not pair<const _K, _V>) so we can move
    // entries during vector growth.  We expose `value_type &`
    // (with const _K) to the user via accessors.
    struct _entry {
        _K first;
        _V second;
        _entry() : first(), second() {}
        _entry(const _K &k) : first(k), second() {}
        _entry(const _K &k, const _V &v) : first(k), second(v) {}
        _entry(_K &&k, _V &&v) : first(std::move(k)), second(std::move(v)) {}
        _entry(const _entry &o) : first(o.first), second(o.second) {}
        _entry(_entry &&o) noexcept
            : first(std::move(o.first)), second(std::move(o.second)) {}
        _entry &operator=(const _entry &o) {
            *(_K *)&first = o.first;
            second = o.second;
            return *this;
        }
        _entry &operator=(_entry &&o) noexcept {
            *(_K *)&first = std::move(*(_K *)&o.first);
            second = std::move(o.second);
            return *this;
        }
    };

    vector<_entry> _v;
    _Cmp           _cmp;

    // Returns index of first entry whose key is not less than k.
    size_type _lb(const _K &k) const {
        size_type lo = 0, hi = _v.size();
        while (lo < hi) {
            size_type mid = (lo + hi) / 2;
            if (_cmp(_v[mid].first, k)) lo = mid + 1;
            else                        hi = mid;
        }
        return lo;
    }

public:
    typedef _entry *       iterator;
    typedef const _entry * const_iterator;

    map() : _v(), _cmp() {}
    map(const map &o) : _v(o._v), _cmp(o._cmp) {}
    map(map &&o) noexcept : _v(std::move(o._v)), _cmp(std::move(o._cmp)) {}
    map &operator=(const map &o) { _v = o._v; _cmp = o._cmp; return *this; }
    map &operator=(map &&o) noexcept { _v = std::move(o._v); _cmp = std::move(o._cmp); return *this; }

    iterator       begin()       noexcept { return _v.data(); }
    iterator       end()         noexcept { return _v.data() + _v.size(); }
    const_iterator begin() const noexcept { return _v.data(); }
    const_iterator end()   const noexcept { return _v.data() + _v.size(); }
    const_iterator cbegin()const noexcept { return _v.data(); }
    const_iterator cend()  const noexcept { return _v.data() + _v.size(); }

    bool      empty() const noexcept { return _v.empty(); }
    size_type size()  const noexcept { return _v.size(); }
    void      clear()       noexcept { _v.clear(); }

    iterator find(const _K &k) {
        size_type i = _lb(k);
        if (i < _v.size() && !_cmp(k, _v[i].first)) return _v.data() + i;
        return end();
    }
    const_iterator find(const _K &k) const {
        size_type i = _lb(k);
        if (i < _v.size() && !_cmp(k, _v[i].first)) return _v.data() + i;
        return end();
    }
    size_type count(const _K &k) const { return find(k) == end() ? 0 : 1; }

    _V &operator[](const _K &k) {
        size_type i = _lb(k);
        if (i < _v.size() && !_cmp(k, _v[i].first)) return _v[i].second;
        _v.insert(_v.begin() + i, _entry(k));
        return _v[i].second;
    }
    _V &at(const _K &k) {
        size_type i = _lb(k);
        return _v[i].second;
    }
    const _V &at(const _K &k) const {
        size_type i = _lb(k);
        return _v[i].second;
    }

    pair<iterator, bool> insert(const value_type &kv) {
        size_type i = _lb(kv.first);
        if (i < _v.size() && !_cmp(kv.first, _v[i].first)) {
            return pair<iterator, bool>(_v.data() + i, false);
        }
        _v.insert(_v.begin() + i, _entry(kv.first, kv.second));
        return pair<iterator, bool>(_v.data() + i, true);
    }
    template <class... _Args>
    pair<iterator, bool> emplace(_Args&&... a) {
        return insert(value_type(std::forward<_Args>(a)...));
    }

    size_type erase(const _K &k) {
        size_type i = _lb(k);
        if (i < _v.size() && !_cmp(k, _v[i].first)) {
            _v.erase(_v.begin() + i);
            return 1;
        }
        return 0;
    }
    iterator erase(iterator pos) {
        size_type i = (size_type)(pos - _v.data());
        _v.erase(_v.begin() + i);
        return _v.data() + i;
    }
};

}  // namespace std

#endif
