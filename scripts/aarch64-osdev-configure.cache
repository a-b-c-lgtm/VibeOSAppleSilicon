# aarch64-osdev-configure.cache — chapter 131d.
#
# This file is used as a CONFIG_SITE script (see
# scripts/test_guest_configure.py: env["CONFIG_SITE"] = CACHE).
# autoconf-generated configure scripts source CONFIG_SITE BEFORE
# running any check, so any `ac_cv_xxx` we assign here short-
# circuits the corresponding probe.
#
# Why we need this at all:
#   Our libc (userspace/libc/*.h) is header-only — every symbol
#   is `static inline`.  autoconf link probes for `xxx()` write
#   `char xxx(); int main() { xxx(); }` with NO #includes, then
#   try to link.  Static inlines don't satisfy that link → probe
#   says "absent" → libiberty compiles its OWN xxx.c → libiberty's
#   xxx redefines what our libc already provides → duplicate-
#   symbol / conflicting-types build errors.
#
#   Pre-populating ac_cv_func_xxx=yes tells autoconf "trust me,
#   it's there" so libiberty skips compiling its replacement.
#
# CRITICAL: this file MUST NOT set any `ac_cv_env_*`, `ac_cv_prog_*`,
# `ac_cv_path_*`, `ac_cv_host`, `ac_cv_target`, etc.  Those are
# the autoconf env handshake — when set in a site script they
# make configure compare them to the *current* environment and
# abort with "environment changed" if anything differs (even by
# a trailing space in CFLAGS).  Site scripts only carry test
# results, not environment snapshots.
#
# CRITICAL #2: never pass --cache-file=<this file> to configure.
# autoconf's cache-file mode WRITES BACK to the file at end of
# run, blowing away the curated contents with an env snapshot.
# We are strictly a SITE script (CONFIG_SITE), which is sourced
# read-only.
#
# Each line uses the `${var=value}` idiom (only-set-if-unset)
# so a real probe later in configure can still override.

# ---- printf / vprintf family (libiberty/{vprintf,vfprintf,vsnprintf,_doprnt,
#      snprintf,printf,fprintf,sprintf,vsprintf}.c → REPLACE_FUNCS) ----
ac_cv_func_printf=${ac_cv_func_printf=yes}
ac_cv_func_fprintf=${ac_cv_func_fprintf=yes}
ac_cv_func_sprintf=${ac_cv_func_sprintf=yes}
ac_cv_func_snprintf=${ac_cv_func_snprintf=yes}
ac_cv_func_vprintf=${ac_cv_func_vprintf=yes}
ac_cv_func_vfprintf=${ac_cv_func_vfprintf=yes}
ac_cv_func_vsprintf=${ac_cv_func_vsprintf=yes}
ac_cv_func_vsnprintf=${ac_cv_func_vsnprintf=yes}
# _doprnt is only pulled in if v*printf are missing; saying we
# have vprintf+vfprintf+vsprintf is enough.  Mark it absent
# anyway so that any explicit check resolves to "no" rather
# than triggering the libiberty/_doprnt.c compile.
ac_cv_func__doprnt=${ac_cv_func__doprnt=no}

# ---- getopt + decls ----
# getopt.c is in REQUIRED_OFILES (Makefile.in) so the cache
# alone can't suppress it — that's why we also patch
# libiberty/getopt.c to ELIDE_CODE under __OSDEV_LIBC__ (see
# vendor/binutils-aarch64-osdev.patch hunk 5).
ac_cv_func_getopt=${ac_cv_func_getopt=yes}
ac_cv_have_decl_getopt=${ac_cv_have_decl_getopt=yes}
ac_cv_have_decl_optarg=${ac_cv_have_decl_optarg=yes}
ac_cv_have_decl_optind=${ac_cv_have_decl_optind=yes}
ac_cv_have_decl_optopt=${ac_cv_have_decl_optopt=yes}
ac_cv_have_decl_opterr=${ac_cv_have_decl_opterr=yes}

# ---- string / stdio ----
ac_cv_func_strerror=${ac_cv_func_strerror=yes}
ac_cv_func_strerror_r=${ac_cv_func_strerror_r=no}
ac_cv_func_getcwd=${ac_cv_func_getcwd=yes}
ac_cv_func_freopen=${ac_cv_func_freopen=yes}
ac_cv_func_mktemp=${ac_cv_func_mktemp=yes}
ac_cv_func_mkstemp=${ac_cv_func_mkstemp=no}
ac_cv_func_abort=${ac_cv_func_abort=yes}

# ---- time ----
ac_cv_func_gettimeofday=${ac_cv_func_gettimeofday=yes}
ac_cv_func_localtime=${ac_cv_func_localtime=yes}
ac_cv_func_gmtime=${ac_cv_func_gmtime=yes}
ac_cv_func_asctime=${ac_cv_func_asctime=yes}
ac_cv_func_ctime=${ac_cv_func_ctime=yes}
ac_cv_func_mktime=${ac_cv_func_mktime=yes}
ac_cv_func_strftime=${ac_cv_func_strftime=yes}
ac_cv_func_time=${ac_cv_func_time=yes}
ac_cv_func_clock=${ac_cv_func_clock=yes}
ac_cv_func_clock_gettime=${ac_cv_func_clock_gettime=yes}

# ---- byte order ----
# autoconf's bigendian probe runs a compile + link of a snippet
# that grovels over the bytes of a magic int.  Our freestanding
# wrapper sometimes can't satisfy the link step (no startup
# code, no host libc).  aarch64 is little-endian by default
# (SCTLR_EL1.E0E=0 / EE=0 in this kernel), so pre-answer.
ac_cv_c_bigendian=${ac_cv_c_bigendian=no}

# ---- headers ----
# autoconf header probes use `#include <name.h>` then compile-only
# (no link).  Our header set is freestanding-friendly, but the
# default probe runs the *outer* configure on the build host first
# (autoconf 2.69 link probe) which can fail when CFLAGS are weird.
# Hard-code yes for every libcpp/libiberty/binutils header we
# actually ship in userspace/libc/.
ac_cv_header_time=${ac_cv_header_time=yes}
ac_cv_header_sys_time_h=${ac_cv_header_sys_time_h=yes}
ac_cv_header_time_h=${ac_cv_header_time_h=yes}
ac_cv_header_unistd_h=${ac_cv_header_unistd_h=yes}
ac_cv_header_dirent_h=${ac_cv_header_dirent_h=yes}
ac_cv_header_string_h=${ac_cv_header_string_h=yes}
ac_cv_header_strings_h=${ac_cv_header_strings_h=yes}
ac_cv_header_stdlib_h=${ac_cv_header_stdlib_h=yes}
ac_cv_header_stdio_h=${ac_cv_header_stdio_h=yes}
ac_cv_header_errno_h=${ac_cv_header_errno_h=yes}
ac_cv_header_signal_h=${ac_cv_header_signal_h=yes}
ac_cv_header_setjmp_h=${ac_cv_header_setjmp_h=yes}
ac_cv_header_assert_h=${ac_cv_header_assert_h=yes}
ac_cv_header_ctype_h=${ac_cv_header_ctype_h=yes}
ac_cv_header_locale_h=${ac_cv_header_locale_h=yes}
ac_cv_header_math_h=${ac_cv_header_math_h=yes}
ac_cv_header_stddef_h=${ac_cv_header_stddef_h=yes}
ac_cv_header_stdint_h=${ac_cv_header_stdint_h=yes}
ac_cv_header_stdarg_h=${ac_cv_header_stdarg_h=yes}
ac_cv_header_inttypes_h=${ac_cv_header_inttypes_h=yes}
ac_cv_header_fcntl_h=${ac_cv_header_fcntl_h=yes}
ac_cv_header_sys_stat_h=${ac_cv_header_sys_stat_h=yes}
ac_cv_header_sys_types_h=${ac_cv_header_sys_types_h=yes}
ac_cv_header_sys_wait_h=${ac_cv_header_sys_wait_h=yes}
ac_cv_header_sys_param_h=${ac_cv_header_sys_param_h=yes}

# ---- process / unistd ----
ac_cv_func_wait=${ac_cv_func_wait=yes}
ac_cv_func_waitpid=${ac_cv_func_waitpid=yes}
ac_cv_func_sleep=${ac_cv_func_sleep=yes}
ac_cv_func_execvp=${ac_cv_func_execvp=yes}
ac_cv_func__exit=${ac_cv_func__exit=yes}
ac_cv_func_link=${ac_cv_func_link=yes}

# ---- math ----
ac_cv_func_ldexp=${ac_cv_func_ldexp=yes}
ac_cv_func_frexp=${ac_cv_func_frexp=yes}

# ---- declarations we genuinely don't have ----
ac_cv_have_decl_basename=${ac_cv_have_decl_basename=no}
ac_cv_have_decl_ffs=${ac_cv_have_decl_ffs=no}
ac_cv_have_decl_asprintf=${ac_cv_have_decl_asprintf=no}
ac_cv_have_decl_vasprintf=${ac_cv_have_decl_vasprintf=no}

# ---- chapter 132f: declarations our libc provides ----
# These match the HAVE_DECL_* settings we patch into gcc's
# auto-host.h.  By telling autoconf we DO have these decls, gcc's
# system.h skips its fallback `extern X` redeclarations.  Those
# redeclarations were conflicting with our C++ ABI inline
# definitions in env.h / malloc.h / printf.h / syscall.h.
ac_cv_have_decl_abort=${ac_cv_have_decl_abort=yes}
ac_cv_have_decl_calloc=${ac_cv_have_decl_calloc=yes}
ac_cv_have_decl_free=${ac_cv_have_decl_free=yes}
ac_cv_have_decl_getcwd=${ac_cv_have_decl_getcwd=yes}
ac_cv_have_decl_getenv=${ac_cv_have_decl_getenv=yes}
ac_cv_have_decl_malloc=${ac_cv_have_decl_malloc=yes}
ac_cv_have_decl_realloc=${ac_cv_have_decl_realloc=yes}
ac_cv_have_decl_sbrk=${ac_cv_have_decl_sbrk=yes}
ac_cv_have_decl_setenv=${ac_cv_have_decl_setenv=yes}
ac_cv_have_decl_snprintf=${ac_cv_have_decl_snprintf=yes}
ac_cv_have_decl_strstr=${ac_cv_have_decl_strstr=yes}
ac_cv_have_decl_unsetenv=${ac_cv_have_decl_unsetenv=yes}
ac_cv_have_decl_vsnprintf=${ac_cv_have_decl_vsnprintf=yes}
ac_cv_type_clock_t=${ac_cv_type_clock_t=yes}
ac_cv_have_struct_tms=${ac_cv_have_struct_tms=yes}
ac_cv_header_sys_times_h=${ac_cv_header_sys_times_h=yes}
ac_cv_func_times=${ac_cv_func_times=yes}
ac_cv_have_decl_times=${ac_cv_have_decl_times=yes}
