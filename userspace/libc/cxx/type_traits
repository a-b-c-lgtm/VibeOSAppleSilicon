// userspace/libc/cxx/type_traits — chapter 132f
//
// Freestanding <type_traits>.  gcc/system.h unconditionally
// includes this header; gcc proper uses it for SFINAE-style
// `std::enable_if`, `std::is_same`, `std::remove_*`, etc.
//
// This is a tiny subset — just the traits gcc 14.2's frontend
// actually uses.  Add more as TUs surface the gap.  All traits
// here are pure compile-time templates with no runtime code.
#ifndef _OSDEV_CXX_TYPE_TRAITS
#define _OSDEV_CXX_TYPE_TRAITS 1

#include <stddef.h>

namespace std {

// ── integral_constant + bool_constant ────────────────────────
template <class _Tp, _Tp __v>
struct integral_constant {
    static constexpr _Tp value = __v;
    typedef _Tp                                value_type;
    typedef integral_constant<_Tp, __v>        type;
    constexpr operator value_type() const noexcept { return value; }
    constexpr value_type operator()() const noexcept { return value; }
};

template <bool __b> using bool_constant = integral_constant<bool, __b>;
typedef bool_constant<true>  true_type;
typedef bool_constant<false> false_type;

// ── is_same ───────────────────────────────────────────────────
template <class, class>     struct is_same       : false_type {};
template <class _T>         struct is_same<_T,_T>: true_type  {};
template <class _T, class _U>
inline constexpr bool is_same_v = is_same<_T, _U>::value;

// ── remove_const / volatile / cv ──────────────────────────────
template <class _Tp> struct remove_const               { typedef _Tp type; };
template <class _Tp> struct remove_const<const _Tp>    { typedef _Tp type; };
template <class _Tp> struct remove_volatile            { typedef _Tp type; };
template <class _Tp> struct remove_volatile<volatile _Tp> { typedef _Tp type; };
template <class _Tp> struct remove_cv {
    typedef typename remove_volatile<typename remove_const<_Tp>::type>::type type;
};
template <class _Tp> using remove_const_t    = typename remove_const<_Tp>::type;
template <class _Tp> using remove_volatile_t = typename remove_volatile<_Tp>::type;
template <class _Tp> using remove_cv_t       = typename remove_cv<_Tp>::type;

// ── remove_reference / add_*_reference ────────────────────────
template <class _Tp> struct remove_reference        { typedef _Tp type; };
template <class _Tp> struct remove_reference<_Tp&>  { typedef _Tp type; };
template <class _Tp> struct remove_reference<_Tp&&> { typedef _Tp type; };
template <class _Tp> using remove_reference_t = typename remove_reference<_Tp>::type;

// ── remove_pointer ────────────────────────────────────────────
template <class _Tp> struct remove_pointer                { typedef _Tp type; };
template <class _Tp> struct remove_pointer<_Tp*>          { typedef _Tp type; };
template <class _Tp> struct remove_pointer<_Tp* const>    { typedef _Tp type; };
template <class _Tp> struct remove_pointer<_Tp* volatile> { typedef _Tp type; };
template <class _Tp> struct remove_pointer<_Tp* const volatile> { typedef _Tp type; };
template <class _Tp> using remove_pointer_t = typename remove_pointer<_Tp>::type;

// ── conditional / enable_if ───────────────────────────────────
template <bool _B, class _T, class _F> struct conditional        { typedef _T type; };
template <class _T, class _F>          struct conditional<false,_T,_F> { typedef _F type; };
template <bool _B, class _T, class _F>
using conditional_t = typename conditional<_B, _T, _F>::type;

template <bool, class _T = void> struct enable_if {};
template <class _T>              struct enable_if<true, _T> { typedef _T type; };
template <bool _B, class _T = void>
using enable_if_t = typename enable_if<_B, _T>::type;

// ── is_integral / is_floating_point (subset) ──────────────────
template <class> struct __is_integral_h : false_type {};
template <> struct __is_integral_h<bool>               : true_type {};
template <> struct __is_integral_h<char>               : true_type {};
template <> struct __is_integral_h<signed char>        : true_type {};
template <> struct __is_integral_h<unsigned char>      : true_type {};
template <> struct __is_integral_h<short>              : true_type {};
template <> struct __is_integral_h<unsigned short>     : true_type {};
template <> struct __is_integral_h<int>                : true_type {};
template <> struct __is_integral_h<unsigned int>       : true_type {};
template <> struct __is_integral_h<long>               : true_type {};
template <> struct __is_integral_h<unsigned long>      : true_type {};
template <> struct __is_integral_h<long long>          : true_type {};
template <> struct __is_integral_h<unsigned long long> : true_type {};
template <class _Tp> struct is_integral : __is_integral_h<remove_cv_t<_Tp>> {};
template <class _Tp> inline constexpr bool is_integral_v = is_integral<_Tp>::value;

template <class> struct __is_fp_h : false_type {};
template <> struct __is_fp_h<float>       : true_type {};
template <> struct __is_fp_h<double>      : true_type {};
template <> struct __is_fp_h<long double> : true_type {};
template <class _Tp> struct is_floating_point : __is_fp_h<remove_cv_t<_Tp>> {};
template <class _Tp> inline constexpr bool is_floating_point_v = is_floating_point<_Tp>::value;

// ── is_pointer ────────────────────────────────────────────────
template <class>     struct __is_ptr_h : false_type {};
template <class _Tp> struct __is_ptr_h<_Tp*> : true_type {};
template <class _Tp> struct is_pointer : __is_ptr_h<remove_cv_t<_Tp>> {};
template <class _Tp> inline constexpr bool is_pointer_v = is_pointer<_Tp>::value;

// ── is_void ───────────────────────────────────────────────────
template <class _Tp> struct is_void : is_same<remove_cv_t<_Tp>, void> {};
template <class _Tp> inline constexpr bool is_void_v = is_void<_Tp>::value;

// ── is_array ──────────────────────────────────────────────────
template <class _Tp> struct is_array              : false_type {};
template <class _Tp> struct is_array<_Tp[]>       : true_type  {};
template <class _Tp, size_t _N> struct is_array<_Tp[_N]> : true_type {};
template <class _Tp> inline constexpr bool is_array_v = is_array<_Tp>::value;

// ── is_reference / is_const / is_volatile / is_function ──────
template <class _Tp> struct is_reference        : false_type {};
template <class _Tp> struct is_reference<_Tp&>  : true_type  {};
template <class _Tp> struct is_reference<_Tp&&> : true_type  {};
template <class _Tp> struct is_lvalue_reference       : false_type {};
template <class _Tp> struct is_lvalue_reference<_Tp&> : true_type  {};
template <class _Tp> struct is_rvalue_reference        : false_type {};
template <class _Tp> struct is_rvalue_reference<_Tp&&> : true_type  {};
template <class _Tp> struct is_const           : false_type {};
template <class _Tp> struct is_const<const _Tp>: true_type  {};
template <class _Tp> struct is_volatile               : false_type {};
template <class _Tp> struct is_volatile<volatile _Tp> : true_type  {};
template <class _Tp> struct is_function : false_type {};
template <class _R, class... _A> struct is_function<_R(_A...)>      : true_type {};
template <class _R, class... _A> struct is_function<_R(_A..., ...)> : true_type {};
template <class _Tp> inline constexpr bool is_reference_v = is_reference<_Tp>::value;
template <class _Tp> inline constexpr bool is_function_v  = is_function<_Tp>::value;

// ── decay (minimal) ───────────────────────────────────────────
template <class _Tp>
struct decay {
    typedef remove_cv_t<remove_reference_t<_Tp>> type;
};
template <class _Tp> using decay_t = typename decay<_Tp>::type;

// ── declval ───────────────────────────────────────────────────
template <class _Tp> _Tp&& declval() noexcept;

// ── is_trivially_* (compiler intrinsics) ──────────────────────
template <class _Tp> struct is_trivial               : bool_constant<__is_trivial(_Tp)> {};
template <class _Tp> struct is_trivially_copyable    : bool_constant<__is_trivially_copyable(_Tp)> {};
template <class _Tp> struct is_trivially_destructible: bool_constant<__has_trivial_destructor(_Tp)> {};
template <class _Tp> struct is_standard_layout       : bool_constant<__is_standard_layout(_Tp)> {};
template <class _Tp> struct is_pod                   : bool_constant<__is_pod(_Tp)> {};
template <class _Tp> struct is_empty                 : bool_constant<__is_empty(_Tp)> {};
template <class _Tp, class... _A> struct is_constructible       : bool_constant<__is_constructible(_Tp, _A...)> {};
template <class _Tp, class... _A> struct is_trivially_constructible : bool_constant<__is_trivially_constructible(_Tp, _A...)> {};
template <class _Tp> struct is_default_constructible : is_constructible<_Tp> {};
template <class _Tp> struct is_trivially_default_constructible : is_trivially_constructible<_Tp> {};
template <class _From, class _To> struct is_convertible        : bool_constant<__is_convertible(_From, _To)> {};
template <class _Tp, class _Up> struct is_assignable           : bool_constant<__is_assignable(_Tp, _Up)> {};
template <class _Tp, class _Up> struct is_base_of              : bool_constant<__is_base_of(_Tp, _Up)> {};
template <class _Tp> struct is_class                           : bool_constant<__is_class(_Tp)> {};
template <class _Tp> struct is_enum                            : bool_constant<__is_enum(_Tp)> {};
template <class _Tp> struct is_union                           : bool_constant<__is_union(_Tp)> {};
template <class _Tp> struct is_abstract                        : bool_constant<__is_abstract(_Tp)> {};
template <class _Tp> struct is_polymorphic                     : bool_constant<__is_polymorphic(_Tp)> {};
template <class _Tp> struct is_final                           : bool_constant<__is_final(_Tp)> {};
template <class _From, class _To> inline constexpr bool is_convertible_v = is_convertible<_From, _To>::value;
template <class _Tp, class _Up> inline constexpr bool is_assignable_v   = is_assignable<_Tp, _Up>::value;
template <class _Tp, class _Up> inline constexpr bool is_base_of_v      = is_base_of<_Tp, _Up>::value;
template <class _Tp> inline constexpr bool is_class_v                   = is_class<_Tp>::value;
template <class _Tp> inline constexpr bool is_enum_v                    = is_enum<_Tp>::value;
template <class _Tp> inline constexpr bool is_trivial_v                = is_trivial<_Tp>::value;
template <class _Tp> inline constexpr bool is_trivially_copyable_v     = is_trivially_copyable<_Tp>::value;
template <class _Tp> inline constexpr bool is_trivially_destructible_v = is_trivially_destructible<_Tp>::value;
template <class _Tp> inline constexpr bool is_standard_layout_v        = is_standard_layout<_Tp>::value;
template <class _Tp> inline constexpr bool is_pod_v                    = is_pod<_Tp>::value;
template <class _Tp> inline constexpr bool is_empty_v                  = is_empty<_Tp>::value;

// ── underlying_type (compiler intrinsic) ──────────────────────
template <class _Tp>
struct underlying_type { typedef __underlying_type(_Tp) type; };
template <class _Tp>
using underlying_type_t = typename underlying_type<_Tp>::type;

} // namespace std

#endif
